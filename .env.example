# ============================================================
#  校园闲换 —— 环境变量模板
#  用法：复制本文件为 .env，按自己的环境修改。
#        .env 已被 .gitignore 忽略，不会被提交。
#  优先级：真实环境变量 > .env > config.py 里的默认值
# ============================================================

# ---------- 数据库（必填） ----------
# 数据库不存在时会自动创建，库名只能用字母 / 数字 / 下划线
XQ_DB_NAME=xq_secondhand
XQ_DB_HOST=127.0.0.1
XQ_DB_PORT=3306
XQ_DB_USER=root
XQ_DB_PASSWORD=在这里填你的 MySQL 密码
# 连接池上限
XQ_DB_POOL_SIZE=20

# ---------- 服务 ----------
# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 允许局域网访问
XQ_HOST=127.0.0.1
XQ_PORT=5000
# 生产环境请保持 0
FLASK_DEBUG=0

# ---------- 安全 ----------
# Flask 会话密钥。留空则自动生成 instance_secret.key（已 gitignore）
XQ_SECRET_KEY=

# ---------- 请求限流（可选，留空用默认值） ----------
# 设为 0 可整体关闭
XQ_RATE_LIMIT_ENABLED=1